#!/bin/bash

red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
plain='\033[0m'

cur_dir=$(pwd)
MY_GITHUB="https://raw.githubusercontent.com/yunfeibuzai/-./main"

# check root
[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain} 必须使用root用户运行此脚本！\n" && exit 1

# check os
if [[ -f /etc/redhat-release ]]; then
    release="centos"
elif cat /etc/issue 2>/dev/null | grep -Eqi "alpine" || cat /proc/version 2>/dev/null | grep -Eqi "alpine"; then
    release="alpine"
elif cat /etc/issue 2>/dev/null | grep -Eqi "debian" || cat /proc/version 2>/dev/null | grep -Eqi "debian"; then
    release="debian"
elif cat /etc/issue 2>/dev/null | grep -Eqi "ubuntu" || cat /proc/version 2>/dev/null | grep -Eqi "ubuntu"; then
    release="ubuntu"
else
    release="debian"
fi

arch=$(uname -m)
if [[ $arch == "x86_64" || $arch == "x64" || $arch == "amd64" ]]; then
    arch="64"
elif [[ $arch == "aarch64" || $arch == "arm64" ]]; then
    arch="arm64-v8a"
else
    arch="64"
fi

install_base() {
    echo -e "${yellow}正在同步组件与证书...${plain}"
    if [[ x"${release}" == x"centos" ]]; then
        yum install epel-release wget curl unzip tar crontabs socat ca-certificates -y >/dev/null 2>&1
        update-ca-trust force-enable >/dev/null 2>&1
    elif [[ x"${release}" == x"alpine" ]]; then
        apk update >/dev/null 2>&1
        apk add wget curl unzip tar socat ca-certificates openssl >/dev/null 2>&1
        update-ca-certificates >/dev/null 2>&1
    elif [[ x"${release}" == x"debian" || x"${release}" == x"ubuntu" ]]; then
        apt-get update -y >/dev/null 2>&1
        apt install wget curl unzip tar cron socat ca-certificates -y >/dev/null 2>&1
        update-ca-certificates >/dev/null 2>&1
    fi
}

check_status() {
    if [[ ! -f /usr/local/V2bX/V2bX ]]; then
        return 2
    fi
    if [[ x"${release}" == x"alpine" ]]; then
        if service V2bX status 2>&1 | grep -Eqi "started|running" || [ -f /run/V2bX.pid ]; then
            return 0
        else
            return 1
        fi
    else
        if systemctl is-active --quiet V2bX; then
            return 0
        else
            return 1
        fi
    fi
}
install_V2bX() {
    if [[ -d /usr/local/V2bX/ ]]; then
        find /usr/local/V2bX/ -type f -not -name "config.json" -delete 2>/dev/null
    else
        mkdir /usr/local/V2bX/ -p
    fi
    cd /usr/local/V2bX/

    if [ $# == 0 ] ;then
        last_version=$(curl -Ls --connect-timeout 8 "https://api.github.com/repos/wyx2685/V2bX/releases/latest" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
        [[ ! -n "$last_version" ]] && last_version="v0.1.7"
        
        url="https://github.com/wyx2685/V2bX/releases/download/${last_version}/V2bX-linux-${arch}.zip"
        wget --no-check-certificate -N --timeout=10 --tries=2 -O /usr/local/V2bX/V2bX-linux.zip "${url}" || wget --no-check-certificate -N --timeout=15 -O /usr/local/V2bX/V2bX-linux.zip "https://ghproxy.net/${url}"
    else
        last_version=$1
        url="https://github.com/wyx2685/V2bX/releases/download/${last_version}/V2bX-linux-${arch}.zip"
        wget --no-check-certificate -N --timeout=10 -O /usr/local/V2bX/V2bX-linux.zip "${url}" || wget --no-check-certificate -N --timeout=15 -O /usr/local/V2bX/V2bX-linux.zip "https://ghproxy.net/${url}"
    fi

    unzip -o V2bX-linux.zip >/dev/null 2>&1
    rm V2bX-linux.zip -f
    chmod +x V2bX
    mkdir /etc/V2bX/ -p
    [[ -f geoip.dat ]] && cp geoip.dat /etc/V2bX/
    [[ -f geosite.dat ]] && cp geosite.dat /etc/V2bX/
    
    if [[ x"${release}" == x"alpine" ]]; then
        rm /etc/init.d/V2bX -f
        cat <<EOF > /etc/init.d/V2bX
#!/sbin/openrc-run
name="V2bX"
command="/usr/local/V2bX/V2bX"
command_args="server"
pidfile="/run/V2bX.pid"
command_background="yes"
depend() { need net; }
EOF
        chmod +x /etc/init.d/V2bX
        rc-update add V2bX default >/dev/null 2>&1
    else
        rm /etc/systemd/system/V2bX.service -f
        cat <<EOF > /etc/systemd/system/V2bX.service
[Unit]
Description=V2bX Service
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
WorkingDirectory=/usr/local/V2bX/
ExecStart=/usr/local/V2bX/V2bX server
Restart=always
RestartSec=5
MemoryLimit=300M
LimitNOFILE=999999

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable V2bX >/dev/null 2>&1
    fi

    if [[ ! -f /etc/V2bX/config.json ]]; then
        [[ -f config.json ]] && cp config.json /etc/V2bX/
        first_install=true
    else
        if [[ x"${release}" == x"alpine" ]]; then service V2bX restart >/dev/null 2>&1; else systemctl restart V2bX >/dev/null 2>&1; fi
        first_install=false
    fi

    for json_file in dns route custom_outbound custom_inbound; do
        [[ ! -f /etc/V2bX/${json_file}.json && -f ${json_file}.json ]] && cp ${json_file}.json /etc/V2bX/
    done

    # 核心优化：把下载管理菜单的地址永久重定向到你自己的专属仓库
    curl -o /usr/bin/V2bX -Ls "${MY_GITHUB}/xiaomaimai" && chmod +x /usr/bin/V2bX
    [[ ! -L /usr/bin/v2bx ]] && ln -s /usr/bin/V2bX /usr/bin/v2bx 2>/dev/null && chmod +x /usr/bin/v2bx 2>/dev/null
    
    cd $cur_dir
}
start_service() {
    check_status
    if [[ $? == 0 ]]; then echo -e "${green}V2bX 已经在运行中...${plain}"; else
        if [[ x"${release}" == x"alpine" ]]; then service V2bX start >/dev/null 2>&1; else systemctl start V2bX >/dev/null 2>&1; fi
        sleep 1 && check_status
        [[ $? == 0 ]] && echo -e "${green}V2bX 启动成功${plain}" || echo -e "${red}启动失败，请查看日志${plain}"
    fi
}

stop_service() {
    if [[ x"${release}" == x"alpine" ]]; then service V2bX stop >/dev/null 2>&1; else systemctl stop V2bX >/dev/null 2>&1; fi
    sleep 1 && check_status
    [[ $? == 1 ]] && echo -e "${green}V2bX 停止成功${plain}" || echo -e "${red}停止失败${plain}"
}

show_log() {
    if [[ x"${release}" == x"alpine" ]]; then echo -e "${yellow}Alpine系统请前往 /var/log/ 查看日志${plain}"; else
        journalctl -u V2bX --no-pager -n 50
    fi
}

show_menu() {
    clear
    echo -e "${green}  V2bX 后端管理脚本 (独家定制版)${plain}"
    # 这一行完美修改成了你的专属 GitHub 仓库地址
    echo -e "${green}--- https://github.com/yunfeibuzai/-. ---${plain}"
    echo -e "  ${green}0.${plain} 修改配置"
    echo -e "————————————————"
    echo -e "  ${green}1.${plain} 安装 V2bX"
    echo -e "  ${green}2.${plain} 更新 V2bX"
    echo -e "  ${green}3.${plain} 卸载 V2bX"
    echo -e "————————————————"
    echo -e "  ${green}4.${plain} 启动 V2bX"
    echo -e "  ${green}5.${plain} 停止 V2bX"
    echo -e "  ${green}6.${plain} 重启 V2bX"
    echo -e "  ${green}7.${plain} 查看 V2bX 状态"
    echo -e "  ${green}8.${plain} 查看 V2bX 日志"
    echo -e "————————————————"
    echo -e "  ${green}17.${plain} 退出脚本"
    
    echo -e "————————————————"
    check_status
    case $? in
        0) echo -e "V2bX状态: ${green}已运行${plain}" ;;
        1) echo -e "V2bX状态: ${red}未运行${plain}" ;;
        2) echo -e "V2bX状态: ${yellow}未安装${plain}" ;;
    esac
    
    read -rp "请输入选择 [0-17]: " select_menu
    case $select_menu in
        0) nano /etc/V2bX/config.json ;;
        1) install_base && install_V2bX ;;
        2) install_V2bX ;;
        3) stop_service && rm -rf /usr/local/V2bX /usr/bin/V2bX /usr/bin/v2bx ;;
        4) start_service ;;
        5) stop_service ;;
        6) stop_service && start_service ;;
        7) check_status && [[ $? == 0 ]] && echo -e "状态: ${green}正在运行${plain}" || echo -e "状态: ${red}未运行${plain}" ;;
        8) show_log ;;
        17) exit 0 ;;
        *) echo -e "${red}请输入正确的数字${plain}" ;;
    esac
}

if [[ $# == 0 ]]; then
    show_menu
else
    case $1 in
        start) start_service ;;
        stop) stop_service ;;
        restart) stop_service && start_service ;;
        status) check_status && [[ $? == 0 ]] && echo "运行中" || echo "未运行" ;;
        log) show_log ;;
        *) show_menu ;;
    esac
fi
