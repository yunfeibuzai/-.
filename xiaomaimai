#!/bin/bash

red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
plain='\033[0m'

cur_dir=$(pwd)

# check root
[[ $EUID -ne 0 ]] && echo -e "${red}错误：${plain} 必须使用root用户运行此脚本！\n" && exit 1

# check os
if [[ -f /etc/redhat-release ]]; then
    release="centos"
elif cat /etc/issue 2>/dev/null | grep -Eqi "alpine" || cat /proc/version 2>/dev/null | grep -Eqi "alpine"; then
    release="alpine"
elif cat /etc/issue 2>/dev/null | grep -Eqi "debian" || cat /proc/version 2>/dev/null | grep -Eqi "debian"; then
    release="debian"
elif cat /etc/issue 2>/dev/null | grep -Eqi "ubuntu" || cat /proc/version 2>/dev/null | grep -Eqi "ubuntu"; then
    release="ubuntu"
elif cat /proc/version 2>/dev/null | grep -Eqi "arch"; then
    release="arch"
else
    release="debian" # 无法识别时默认走通用的 debian 系组件
fi

arch=$(uname -m)
if [[ $arch == "x86_64" || $arch == "x64" || $arch == "amd64" ]]; then
    arch="64"
elif [[ $arch == "aarch64" || $arch == "arm64" ]]; then
    arch="arm64-v8a"
else
    arch="64"
fi

echo "系统检测: ${release} | 架构: ${arch}"

if [ "$(getconf WORD_BIT)" != '32' ] && [ "$(getconf LONG_BIT)" != '64' ] ; then
    echo "仅支持64位系统" && exit 2
fi

# os version
if [[ -f /etc/os-release ]]; then
    os_version=$(awk -F'[= ."]' '/VERSION_ID/{print $3}' /etc/os-release)
fi

install_base() {
    echo -e "${yellow}正在同步组件与证书...${plain}"
    if [[ x"${release}" == x"centos" ]]; then
        yum install epel-release wget curl unzip tar crontabs socat ca-certificates -y >/dev/null 2>&1
        update-ca-trust force-enable >/dev/null 2>&1
    elif [[ x"${release}" == x"alpine" ]]; then
        apk update >/dev/null 2>&1
        apk add wget curl unzip tar socat ca-certificates openssl >/dev/null 2>&1
        update-ca-certificates >/dev/null 2>&1
    elif [[ x"${release}" == x"debian" || x"${release}" == x"ubuntu" ]]; then
        apt-get update -y >/dev/null 2>&1
        apt install wget curl unzip tar cron socat ca-certificates -y >/dev/null 2>&1
        update-ca-certificates >/dev/null 2>&1
    elif [[ x"${release}" == x"arch" ]]; then
        pacman -Sy --noconfirm >/dev/null 2>&1
        pacman -S --noconfirm --needed wget curl unzip tar cron socat ca-certificates >/dev/null 2>&1
    fi
}
check_status() {
    if [[ ! -f /usr/local/V2bX/V2bX ]]; then
        return 2
    fi
    if [[ x"${release}" == x"alpine" ]]; then
        if service V2bX status 2>&1 | grep -Eqi "started|running" || [ -f /run/V2bX.pid ]; then
            return 0
        else
            return 1
        fi
    else
        if systemctl is-active --quiet V2bX; then
            return 0
        else
            return 1
        fi
    fi
}

install_V2bX() {
    if [[ -d /usr/local/V2bX/ ]]; then
        find /usr/local/V2bX/ -type f -not -name "config.json" -delete 2>/dev/null
    else
        mkdir /usr/local/V2bX/ -p
    fi
    cd /usr/local/V2bX/

    if [ $# == 0 ] ;then
        last_version=$(curl -Ls --connect-timeout 8 "https://api.github.com/repos/wyx2685/V2bX/releases/latest" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
        if [[ ! -n "$last_version" ]]; then
            echo -e "${yellow}警告: API 请求受限，启用本地硬编码默认版本安装...${plain}"
            last_version="v0.1.7" # 硬编码防爆底线
        fi
        
        echo -e "准备安装 V2bX 版本：${last_version}"
        # 核心优化：如果主线GitHub超时，自动切ghproxy镜像源加速
        url="https://github.com/wyx2685/V2bX/releases/download/${last_version}/V2bX-linux-${arch}.zip"
        wget --no-check-certificate -N --timeout=10 --tries=2 -O /usr/local/V2bX/V2bX-linux.zip "${url}"
        if [[ $? -ne 0 ]]; then
            echo -e "${yellow}主线连接超时，正在切换加速镜像站下载...${plain}"
            wget --no-check-certificate -N --timeout=15 -O /usr/local/V2bX/V2bX-linux.zip "https://ghproxy.net/${url}"
        fi
    else
        last_version=$1
        url="https://github.com/wyx2685/V2bX/releases/download/${last_version}/V2bX-linux-${arch}.zip"
        wget --no-check-certificate -N --timeout=10 -O /usr/local/V2bX/V2bX-linux.zip "${url}" || wget --no-check-certificate -N --timeout=15 -O /usr/local/V2bX/V2bX-linux.zip "https://ghproxy.net/${url}"
    fi

    unzip -o V2bX-linux.zip >/dev/null 2>&1
    rm V2bX-linux.zip -f
    chmod +x V2bX
    mkdir /etc/V2bX/ -p
    [[ -f geoip.dat ]] && cp geoip.dat /etc/V2bX/
    [[ -f geosite.dat ]] && cp geosite.dat /etc/V2bX/
    if [[ x"${release}" == x"alpine" ]]; then
        rm /etc/init.d/V2bX -f
        cat <<EOF > /etc/init.d/V2bX
#!/sbin/openrc-run
name="V2bX"
command="/usr/local/V2bX/V2bX"
command_args="server"
pidfile="/run/V2bX.pid"
command_background="yes"
depend() { need net; }
EOF
        chmod +x /etc/init.d/V2bX
        rc-update add V2bX default >/dev/null 2>&1
    else
        rm /etc/systemd/system/V2bX.service -f
        cat <<EOF > /etc/systemd/system/V2bX.service
[Unit]
Description=V2bX Service
After=network.target nss-lookup.target
Wants=network.target

[Service]
User=root
Type=simple
WorkingDirectory=/usr/local/V2bX/
ExecStart=/usr/local/V2bX/V2bX server
Restart=always
RestartSec=5
MemoryLimit=300M
LimitNOFILE=999999

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable V2bX >/dev/null 2>&1
    fi

    if [[ ! -f /etc/V2bX/config.json ]]; then
        [[ -f config.json ]] && cp config.json /etc/V2bX/
        first_install=true
    else
        if [[ x"${release}" == x"alpine" ]]; then service V2bX restart >/dev/null 2>&1; else systemctl restart V2bX >/dev/null 2>&1; fi
        sleep 1.5
        check_status
        [[ $? == 0 ]] && echo -e "${green}V2bX 节点重启成功！${plain}" || echo -e "${red}启动失败，请检查/etc/V2bX/config.json格式${plain}"
        first_install=false
    fi

    for json_file in dns route custom_outbound custom_inbound; do
        [[ ! -f /etc/V2bX/${json_file}.json && -f ${json_file}.json ]] && cp ${json_file}.json /etc/V2bX/
    done

    curl -o /usr/bin/V2bX -Ls https://raw.githubusercontent.com/wyx2685/V2bX-script/master/V2bX.sh && chmod +x /usr/bin/V2bX
    [[ ! -L /usr/bin/v2bx ]] && ln -s /usr/bin/V2bX /usr/bin/v2bx 2>/dev/null && chmod +x /usr/bin/v2bx 2>/dev/null
    
    cd $cur_dir
    clear
    echo -e "${green}=========================================="
    echo -e "V2bX 节点端极致优化版安装完成！"
    echo -e "输入 V2bX 或 v2bx 即可呼出管理菜单"
    echo -e "==========================================${plain}"
    
    if [[ $first_install == true ]]; then
        read -rp "首次安装，是否立即自动生成配置文件？(y/n): " if_generate
        if [[ $if_generate == [Yy] ]]; then
            curl -o ./initconfig.sh -Ls https://raw.githubusercontent.com/wyx2685/V2bX-script/master/initconfig.sh
            source initconfig.sh && rm initconfig.sh -f && generate_config_file
        fi
    fi
}

install_base
install_V2bX $1
